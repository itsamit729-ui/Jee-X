AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://jee-edge-api
CORS_ORIGINS=http://localhost:5173

# Shared password for the read-only /admin dashboard. Set the real value only
# in your deployment environment; never commit the real password to Git.
ADMIN_PASSWORD=choose-a-strong-admin-password

# Aiven MySQL only — no SQLite fallback. Copy the "Service URI" pieces from the
# Aiven console and rewrite the scheme from mysql:// to mysql+pymysql://
DATABASE_URL=mysql+pymysql://avnadmin:<password>@<service>-<project>.aivencloud.com:<port>/defaultdb
DB_SSL_CA=./ca.pem
