# Local development only; production must use HTTPS and secure cookies.
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Set false to allow ordinary accounts to sign in without verifying email.
# Leave true when email ownership must be verified. Requires redeployment.
REQUIRE_EMAIL_VERIFICATION=true

# HTTPS transactional email API. Sender must be verified with the provider.
AUTH_EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-your-api-key
AUTH_EMAIL_FROM=verified-sender@example.com
# Alternative: AUTH_EMAIL_PROVIDER=resend and set RESEND_API_KEY.

ADMIN_PASSWORD=choose-a-strong-admin-password
DATABASE_URL=mysql+pymysql://avnadmin:<password>@<service>-<project>.aivencloud.com:<port>/defaultdb
DB_SSL_CA=./ca.pem

# Verified JEE Main exam dates maintained by the operator: year -> ISO date.
# Leave empty until official dates are configured; roadmap shows a planning horizon.
JEE_MAIN_EXAM_DATES={}
